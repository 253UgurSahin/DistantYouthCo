# Copy to .env and fill in. Never commit .env.

# Claude API key for the YouTube descriptions and album names (or set it in the app under Instellingen).
ANTHROPIC_API_KEY=

# Port the app listens on.
PORT=3000

# Set to 1 when the app is behind HTTPS (a reverse proxy such as Caddy or Nginx), so the login cookie is Secure.
COOKIE_SECURE=0

# Set to 1 when a reverse proxy sits in front, so the login rate limit sees the real visitor address.
TRUST_PROXY=0

# Largest file you can upload, in MB.
MAX_UPLOAD_MB=4096

# Where the database and uploads live (in Docker: the studio-data volume at /data).
# DATA_DIR=./data
