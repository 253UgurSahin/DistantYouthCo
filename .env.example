# Distant Youth Studio. Op shared hosting maakt de app dit bestand bij het eerste bezoek zelf aan
# (als .env), met een eigen APP_KEY. Je hoeft hier dus niets in te vullen.

APP_NAME="Distant Youth Studio"
APP_ENV=production
# De sleutel waarmee de app cookies en je opgeslagen Claude-key versleutelt. Leeg: wordt zelf gemaakt.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=nl
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_LEVEL=warning

# Standaard SQLite in storage/app/database.sqlite. MySQL van je host kan ook: zet DB_CONNECTION=mysql
# en vul DB_HOST, DB_DATABASE, DB_USERNAME en DB_PASSWORD in.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
# 30 dagen ingelogd blijven
SESSION_LIFETIME=43200
SESSION_COOKIE=dyc_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Claude voor de YouTube-beschrijvingen en albumnamen (of zet de key in de app bij Instellingen).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 1 als er een proxy voor de app staat (Cloudflare, Nginx), zodat de app het echte bezoekersadres ziet.
TRUST_PROXY=0
