# Copy to .env and fill in. Never commit .env.

# Claude API key for the YouTube descriptions and album names (or set it in the app under Instellingen).
ANTHROPIC_API_KEY=

# Port the app listens on.
PORT=3000

# Set to 1 when the app is behind HTTPS (a reverse proxy such as Caddy or Nginx), so the login cookie is Secure.
COOKIE_SECURE=0

# Set to 1 when a reverse proxy sits in front, so the login rate limit sees the real visitor address.
TRUST_PROXY=0

# Largest file you can upload, in MB.
MAX_UPLOAD_MB=4096

# Where the database and uploads live (in Docker: the studio-data volume at /data).
# DATA_DIR=./data

# Direct upload to YouTube: the OAuth client of your own Google Cloud project (or set them in the app under Instellingen).
# The README explains how to make one. The redirect URI to register is shown in the app under Instellingen.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# The public address of the app, when it runs behind a proxy or on a domain (used for the YouTube redirect URI).
# PUBLIC_URL=https://studio.example.com
